# Kernel configuration of the sirius image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# Format 2: arm:configs/common.config, soc:configs/sdm710.config and os:configs/ipados.config
# apply first, then this file overrides them. The result must stay the first-console
# configuration the port was qualified with: ArmDTPlatform (the device-tree platform expert)
# and ArmCpu (the CPU/GIC/timer driver) drive the board through the ADT generated from
# dts/sirius.dts. No storage, display or PMGR components yet: XNU is expected to reach the video
# console and stop at the root device (or the AMFI No-PMGR panic).

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# The boot progress display (package/, mounted as kits/sirius): draws the kernel console lines
# on the frame buffer in a readable font. Upstream's interlock requires the UFS/owner-root,
# Virtio and source-corecrypto build; this board is eMMC and relaxes it in
# scripts/build-xnu-4k-baseline.sh (the one documented deviation from the upstream script).
CONFIG_XNU_BOOT_PROGRESS=y
# The BCM2837 machine config hardcodes a Raspberry Pi panic-log address; with this flag the
# panic region comes from the device tree instead (absent here, which skips it safely).
CONFIG_XNU_DT_PANIC_REGION=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# The DEVELOPMENT kernel references native_legacy_display_probe() unconditionally
# (offline-component-load-probes.patch); the dormant stub archive of
# scripts/build-sirius-probes.py keeps the link closed (package/LegacyDisplayProbe.cpp).
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/sirius-probes/libSiriusProbes.a"
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Profile settings turned off on purpose. The ARM64 profile enables the native AES accelerator,
# and the iPadOS profile enables the mockfs provider, the trust-cache runtime and the CS hash
# cache. The first-console image has none of them; re-enable each one together
# with the stage that needs it (storage/root for mockfs and the trust cache, native AES for the
# storage path) and record the result in porting.toml.
#
# Do NOT set CONFIG_XNU_NATIVE_ARCH_TIMER=n here. build-xnu-4k-baseline.sh derives it from
# XNU_ARMCPU when the variable is absent, and the ARM64 profile leaves it on:
#   NATIVE_ARCH_TIMER=${XNU_NATIVE_ARCH_TIMER:-${XNU_ARMCPU:-0}}
# At 0, architectural-timer-entry.patch compiles the BCM2837 local interrupt router write into
# start.s (0x40000040 + cpu*4, the Raspberry Pi local peripherals). That address does not exist
# on SDM710 and the store aborts before the MMU is on, which looks like a hang right after the
# entry probe's blue bar with no magenta bar.
#
# PAN must stay on (the ARM64 profile default). Kryo 360 implements PAN, and XNU's
# SCTLR_EL1_DEFAULT leaves SPAN clear, so the CPU sets PSTATE.PAN on every exception entry to
# EL1. With CONFIG_XNU_NATIVE_PAN=n copyio never clears it again, so a copyin/copyout that runs
# with PAN set takes a level-3 permission fault, vm_fault finds the page present and returns
# success, and the store faults again forever. That was the init copyout loop and the launchd
# stack loop after the exec.
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n

# Compile the bsd_init call site of sheng-platform-power.patch so package/SiriusPmgr.cpp can
# advertise the ApplePMGRNub that AMFI looks for (the target kernelcache stays unmodified).
CONFIG_XNU_SHENG_PMGR=1

# dyld's shared cache is in the SystemOS cryptex, not on the root volume: with neither mounted,
# launchd's shared_region_check_np returns ENOMEM and dyld stops. offline-owner-systemos-mount.patch
# (ARM64 series) mounts the SystemOS volume (8846FE78-..., the patch default for this image) as a
# union over / before launchd starts and sets dyld's no-ignition bit, as asteroids and tb128fu do.
# BRINGUP_OWNER_CACHE builds it without the owner root trust chain (scripts/build-xnu-4k-baseline.sh);
# package/NativeEmmc.cpp then authorizes the eMMC volumes only with sirius-allow-unverified=1.
# The Data volume (OWNER_DATA_MOUNT) needs a Data seed and the RAM block device and comes later.
CONFIG_XNU_BRINGUP_OWNER_CACHE=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
